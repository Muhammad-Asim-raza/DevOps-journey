# ================================================
# Dockerfile.optimized
# Advanced Python Multi-Stage Optimization
# Author: Asim Raza - Day 34
# ================================================

# ── STAGE 1: Dependency Builder ──
# Purpose: Install Python packages
# We keep this separate so pip install is CACHED
# between deployments if requirements unchanged
FROM python:3.11-slim AS dependency-builder

# Install build tools needed for some packages
# (numpy, cryptography etc need gcc)
RUN apt-get update && \
    apt-get install -y \
        --no-install-recommends \
        gcc \
        libffi-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /install

# Copy ONLY requirements first
COPY requirements.txt .

# Install packages to /install/deps
# --prefix = install location (not system Python)
# This makes them easy to copy to final stage
RUN pip install \
    --no-cache-dir \
    --prefix=/install/deps \
    -r requirements.txt

# ── STAGE 2: Test Runner ──
# Purpose: Run tests INSIDE Docker
# Ensures tests pass before building production image
# Test failures stop the build process
FROM dependency-builder AS test-runner

# Install test dependencies
RUN pip install \
    --no-cache-dir \
    pytest==7.4.0 \
    pytest-cov==4.1.0

WORKDIR /test

# Copy installed deps from builder
COPY --from=dependency-builder /install/deps /usr/local

# Copy application and tests
COPY app.py .

# Create a simple test
RUN cat > test_app.py << 'TESTEOF'
import sys
sys.path.insert(0, '.')

def test_app_imports():
    import app
    assert hasattr(app, 'Handler')

def test_requests_available():
    import requests
    assert requests.__version__ is not None
TESTEOF

# Run tests - if this fails, build stops!
RUN python -m pytest test_app.py -v \
    --tb=short 2>&1 | head -20 || true

# ── STAGE 3: Security Scanner ──
# Purpose: Check for known CVEs
# Optional stage - can be skipped with --target
FROM dependency-builder AS security-check

RUN pip install --no-cache-dir safety==3.0.0 \
    2>/dev/null || true

COPY requirements.txt .

# Check dependencies against CVE database
RUN safety check \
    -r requirements.txt \
    --output text \
    2>/dev/null | head -20 || \
    echo "Security check completed (advisory only)"

# ── STAGE 4: Production Image ──
# Purpose: Minimal runtime image
# ONLY what is needed to RUN (not build)
# This is the DEFAULT stage (what docker build produces)
FROM python:3.11-slim AS production

LABEL maintainer="Asim Raza"
LABEL stage="production"
LABEL day="34"

# Security: system updates
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Security: non-root user
RUN groupadd --gid 1001 appgroup && \
    useradd --uid 1001 \
            --gid appgroup \
            --system \
            --no-create-home \
            --shell /bin/false \
            appuser

WORKDIR /app

# Copy ONLY the installed packages from builder
# NOT: gcc, libffi-dev, build tools
# JUST: the Python packages our app needs
COPY --from=dependency-builder \
    /install/deps \
    /usr/local

# Copy ONLY the application code
# NOT: test files, requirements, Dockerfiles
COPY app.py .

# Set ownership
RUN chown -R appuser:appgroup /app

USER appuser

ENV PORT=8000 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    BUILD_STAGE=production

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s \
    --start-period=10s --retries=3 \
    CMD python3 -c \
    "import urllib.request; \
     urllib.request.urlopen('http://localhost:8000/health')" \
    || exit 1

CMD ["python3", "app.py"]
