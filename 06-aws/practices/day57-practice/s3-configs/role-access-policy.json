{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCICDRole",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/github-actions-role"
      },
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::devops-journey-artifacts",
        "arn:aws:s3:::devops-journey-artifacts/*"
      ]
    }
  ]
}
