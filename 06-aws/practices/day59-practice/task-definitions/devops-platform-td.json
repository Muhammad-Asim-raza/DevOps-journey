{
    "family": "",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam:::role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam:::role/-task-role",
    "containerDefinitions": [
        {
            "name": "app",
            "image": ":sha-",
            "portMappings": [
                {
                    "containerPort": 8000,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {"name": "APP_ENV",   "value": "production"},
                {"name": "PORT",      "value": "8000"},
                {"name": "LOG_LEVEL", "value": "INFO"}
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/",
                    "awslogs-region": "",
                    "awslogs-stream-prefix": "app",
                    "awslogs-create-group": "true"
                }
            },
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "python3 -c \"import urllib.request; urllib.request.urlopen('http://localhost:8000/health')\" || exit 1"
                ],
                "interval": 30,
                "timeout": 5,
                "retries": 3,
                "startPeriod": 60
            },
            "readonlyRootFilesystem": true,
            "user": "1001",
            "linuxParameters": {
                "capabilities": {
                    "drop": ["ALL"]
                },
                "initProcessEnabled": true
            },
            "mountPoints": [
                {
                    "sourceVolume": "tmp-volume",
                    "containerPath": "/tmp",
                    "readOnly": false
                }
            ]
        }
    ],
    "volumes": [
        {
            "name": "tmp-volume"
        }
    ],
    "tags": [
        {"key": "Project", "value": "devops-journey"},
        {"key": "Day", "value": "59"}
    ]
}
